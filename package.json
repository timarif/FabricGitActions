{
  "name": "fabric-deploy-action",
  "version": "1.1.0",
  "private": true,
  "description": "GitHub Action for planning and deploying Microsoft Fabric workspaces, items, and workspace controls.",
  "author": "Tim Arif and contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/timarif/FabricGitActions.git"
  },
  "homepage": "https://github.com/timarif/FabricGitActions#readme",
  "bugs": {
    "url": "https://github.com/timarif/FabricGitActions/issues"
  },
  "keywords": [
    "github-actions",
    "microsoft-fabric",
    "deployment",
    "data-engineering",
    "power-bi",
    "real-time-intelligence"
  ],
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run build && npm run test",
    "package": "tsc && ncc build lib/src/index.js -o dist --minify"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "ajv": "^8.17.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vercel/ncc": "^0.44.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
